@import url('https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap');
 
body{
    overflow-x: hidden;
}
.Home{
    font-family: 'Rubik', sans-serif;
    position: relative;
    font-size: 20px;
    text-decoration: #000;
}
.Acerca-de{
    font-family: 'Rubik', sans-serif;
    position: relative;
    left: 70px;
    bottom: 24px;
    font-size: 20px;
}
.Contacto{
    font-family: 'Rubik', sans-serif;
    position: relative;
    left: 180px;
    bottom: 47px;
    font-size: 20px;
}
.Carrito{
    font-family: 'Rubik', sans-serif;
    position: relative;
    left: 90%;
    bottom: 50px;
    font-size: 20px;
}
ul{
    list-style: none;
}
a{
    text-decoration: none;
    color: #000;
}
h1{
    font-family: 'Rubik', sans-serif;
    font-size: 30px;
    text-align: center;
}
.Nombre{
    font-family: 'Rubik', sans-serif;
    position: relative;
    left: 40%;
    top: 30px;
    padding: 10px;
}
.Email{
    font-family: 'Rubik', sans-serif;
    position: relative;
    left: 512px;
    top: 90px;
    padding: 10px; 
}
button{
    font-family: 'Rubik', sans-serif;
    position: relative;
    left: 20%;
    top: 160px;
    background-color: #8b8b8b;
    border: none;
    padding: 10px 20px;
}
 
/* ================= MEDIA QUERIES ================= */
 
/* Tablet */
@media (max-width: 768px){
    ul{
        padding: 0 16px;
    }
    .Home,
    .Acerca-de,
    .Contacto,
    .Carrito{
        left: 0;
        bottom: 0;
        display: inline-block;
        margin: 0 20px 10px 0;
        font-size: 18px;
    }
    h1{
        font-size: 26px;
    }
    .Nombre,
    .Email{
        display: block;
        left: 0;
        top: 0;
        width: 90%;
        max-width: 400px;
        margin: 20px auto;
    }
    button{
        display: block;
        left: 0;
        top: 0;
        margin: 30px auto;
    }
}
 
/* Móvil */
@media (max-width: 480px){
    .Home,
    .Acerca-de,
    .Contacto,
    .Carrito{
        display: block;
        margin: 0 0 12px 0;
        font-size: 16px;
    }
    h1{
        font-size: 22px;
    }
    .Nombre,
    .Email{
        width: 100%;
        max-width: none;
    }
    button{
        width: 100%;
    }
}
