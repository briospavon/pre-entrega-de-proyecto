/* ==========================================================================
IMPORTS (Google Fonts)
   ========================================================================== */
@import url('https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap');

/* ==========================================================================
BASE / RESET
   ========================================================================== */
a{
    text-decoration: none;
    color: #000;
}


/* ==========================================================================
HEADER / NAV
   ========================================================================== */
.header{
    background-color: #E3E6f3;
    position: sticky;
    top: 0px;
    z-index: 1000;
}
nav{
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 32px;
    padding: 16px 32px;
}

nav ul{
    list-style: none;
    display: flex;
    align-items: center;
    gap: 24px;
}

.Home{
    font-family: 'Rubik', sans-serif;
    font-size: 20px;
}
.Acerca-de{
    font-family: 'Rubik', sans-serif;
    font-size: 20px;
}
.Contacto{
    font-family: 'Rubik', sans-serif;
    font-size: 20px;
}
.Blog{
    font-family: 'Rubik', sans-serif;
    font-size: 20px;

}

.Tienda{
    font-family: 'Rubik', sans-serif;
    font-size: 20px;
}

.carrito{
    font-size: 32px;
    color: #333;
    display: flex;
    align-items: center;
}

.bolsa-de-compra{
    font-size: 32px;
    color: #333;
    display: flex;
    align-items: center;
}

/* ==========================================================================
TIPOGRAFÍA (encabezados generales)
   ========================================================================== */
h1{
    font-family: 'Rubik', sans-serif;
    font-size: 50px;
    color: #222;
}
h2{
    font-family: 'Rubik', sans-serif;
    font-size: 50px;
    color: #222;
}
h4{
    font-family: 'Rubik', sans-serif;
    color: #222;
}
h5{
    font-family: 'Fira Sans', sans-serif;
    color: #9b9b9b;
    font-size: 20px;
}

/* ==========================================================================
BOTONES
   ========================================================================== */
.hero-button{
    background-color: #088178;
    color: #fff;
    border: none;
    padding: 12px 24px;
    margin-top: 40px;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

/* ==========================================================================
HERO
   ========================================================================== */
.hero{
    display: flex;  
    justify-content: flex-end;
    width: 100%;
    height: 80rem;
    background-image: url('chica-musica.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
}
.hero .hero-content{
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    padding: 40px;
    margin-top: 300px;
}
.hero .hero-content h4{
    color: #088178;
    margin-bottom: 10px;
    font-size: 1.5rem;
}
.hero .hero-content h2{
    color: #fff;
    margin-bottom: 10px;
    font-size: 4rem;
}
.hero .hero-content h1{
    color: #088178;
    margin-bottom: 15px;
    font-size: 3.5rem;
}
/* ==========================================================================
PRODUCTOS
   ========================================================================== */
.titulo-productos h2{
    text-align: center;
    margin: 100px 0px;
    margin-bottom: 20px;
}
.titulo-productos h4{
    text-align: center;
    margin: 40px 0px;
    font-family: 'Fira Sans', sans-serif;
    color: #9b9b9b;
    font-size: 20px;
}
.producto-descripcion{
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
}
.productos-container{ 
    width: 100%;
    max-width: 1200px;        
    height: 500px;
    margin: 150px auto 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}
.productos-container .producto{ 
    display: flex;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 15px;
}
.productos-container .producto span{
    display: flex;
    padding-bottom: 0.5rem;
    padding-left: 0rem;
    font-family: 'Courier New', Courier, monospace;
}
.productos-container .producto h5{
    display: flex;
    flex-direction: column;
    font-size: 25px;
    margin: 0px;
    color: #000;
}
.productos-container .producto h4{
    display: flex;
    flex-direction: column;
    font-size: 25px;
    margin: 0px;
    color: #088178;
}
.productos-container .producto a{
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: 8px;
    background-color: #088178;
    color: #fff;
    text-decoration: none;
}
.producto-item{
    border: #9cd2cf 1px solid;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
    box-sizing: border-box;
}


/* ==========================================================================
Ofertas
   ========================================================================== */

.Ofertas{
    background-image: url(estudio.png);
    width: 100%;
    height: 50rem;
    display: flex;
    justify-content: flex-end;
    margin-top: 30%;
}
.Ofertas h3{
    font-family:'Rubik', sans-serif;
    font-size: 50px;
    color: #088178 ;
    display:flex;
    margin-top: 23rem;
    margin-right: 6rem;
}
.button-ofertas{
    background-color: #088178;
    color: #fff;
    border: none;
    padding: 12px 24px;
    margin-top: 25%;
    margin-right: 7%;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    height: 60px;
    position: absolute;
}
/* ==========================================================================
Opiniones
   ========================================================================== */
.opiniones-container{
    background-color: #f3f4f8;
    display: grid;
}
.opiniones{
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
}
.opiniones-lista{
    display: flex;          
    gap: 20px;
    justify-content: center;
    margin-top: 2rem;
    width: 100%;
}
.opiniones h2{
    text-align: center;
    padding-top: 2rem;
}
.opiniones h4{
    font-size: 20px;
    color: #9b9b9b;
    text-align: center;
}
.opiniones p{
    font-size: 20px;
    font-family: 'Rubik', sans-serif;
    color: #000;
    border: 1px solid #9cd2cf;
    border-radius: 10px;
    text-align: left;
    width: 30%;
    height: 10rem;
    line-height: 2rem;
    padding: 10px;
    display: flex;
}
.opiniones .opinion-2{
    font-size: 20px;
    font-family: 'Rubik', sans-serif;
    color: #000;
    border: 1px solid #9cd2cf;
    border-radius: 10px;
    text-align: left;
    width: 30%;
    height: 10rem;
    display: flex;
}
/* ==========================================================================
Email
   ========================================================================== */
.email{
    background-color: #010736;
    display: flex;
    padding-bottom: 40px;
}
.email h3{
    font-family: 'Rubik', sans-serif;
    font-size: 30px;
    color: #fff;
    display: flex;
    margin: 50px;
    margin-top: 30px
}
.email h4{
    font-family: 'Fira Sans', sans-serif;
    font-size: 20px;
    color: #9b9b9b;
    display: flex;
    margin-top: 6rem;
    margin-left: 50px;
    position: absolute;
}
.form-correo{
    display: flex;
    align-items: center;   
    gap: 16px;             
    margin-left: 15rem;   
    margin-top: 2rem;
}

.Correo{
    font-family: 'Fira Sans', sans-serif;
    box-sizing: border-box;
    width: 350px;
    height: 48px;
    padding: 0px 20px;
    font-size: 18px;
    font-weight: 500;
}

.boton-correo{
    height: 48px; 
    padding: 0 24px;
    background-color: #088178;
    color: #fff;
    border: none;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}
/*==========================================================================
    Footer
   ========================================================================== */

footer{
    display: flex;
    justify-content: center;  
    align-items: flex-start;   
    flex-wrap: wrap;          
}

.contacto-footer{
    margin: 5rem;
}
.contacto-footer h5{
    font-family: 'Rubik', sans-serif;
    color: #000;
}
.contacto-footer strong{
    font-family: 'Rubik', sans-serif;
}
.contacto-footer p{
    font-family: 'Fira Sans', sans-serif;
}
.contacto-footer i{
    font-size: 20px;
}
.Mi-cuenta{
    margin: 5rem;
}
.Mi-cuenta h5{
    font-family: 'Rubik', sans-serif;
    color: #000;
}
.Mi-cuenta div{
    display: flex;
    flex-direction: column;    
    gap: 0.5rem;             
}
.Mi-cuenta a{
    font-family: 'Fira Sans', sans-serif;
}
/* ==========================================================================
RESPONSIVE
   ========================================================================== */

/* ---------- Laptop chica / tablet horizontal (hasta 1024px) ---------- */
@media (max-width: 1024px){

    h1, h2{ font-size: 40px; }

    nav{ padding: 16px 20px; }

    /* Hero */
    .hero{ height: 50rem; }
    .hero .hero-content{ margin-top: 150px; }
    .hero .hero-content h2{ font-size: 3rem; }
    .hero .hero-content h1{ font-size: 2.5rem; }

    /* Productos: 4 -> 2 columnas */
    .productos-container{
        grid-template-columns: repeat(2, 1fr);
        height: auto;              /* ya no hay 500px fijos */
        margin-top: 80px;
        padding: 0 20px;
        box-sizing: border-box;
    }

    /* Ofertas */
    .Ofertas{
        height: 35rem;
        margin-top: 60px;          /* el 30% se compensaba con el height fijo de arriba */
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
    .Ofertas h3{
        font-size: 36px;
        margin-top: 12rem;
        margin-right: 3rem;
    }
    .button-ofertas{ margin-top: 18%; }

    /* Opiniones */
    .opiniones-lista{
        flex-wrap: wrap;
        padding: 0 20px;
        box-sizing: border-box;
    }
    .opiniones p,
    .opiniones .opinion-2{
        width: 45%;
        height: auto;
        min-height: 10rem;
    }

    /* Email */
    .form-correo{ margin-left: 5rem; }

    /* Footer */
    .contacto-footer,
    .Mi-cuenta{ margin: 3rem; }
}

/* ---------- Tablet vertical / celular grande (hasta 768px) ---------- */
@media (max-width: 768px){

    h1, h2{ font-size: 32px; }
    h5{ font-size: 18px; }

    /* Nav: logo/links centrados y en varias filas si no entran */
    nav{
        flex-direction: column;
        justify-content: center;
        gap: 12px;
    }
    nav ul{
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        padding: 0;
        margin: 0;
    }
    .Home, .Acerca-de, .Contacto, .Blog, .Tienda{ font-size: 18px; }

    /* Hero */
    .hero{ height: 40rem; }
    .hero .hero-content{
        padding: 20px;
        margin-top: 100px;
    }
    .hero .hero-content h4{ font-size: 1.2rem; }
    .hero .hero-content h2{ font-size: 2.2rem; }
    .hero .hero-content h1{ font-size: 2rem; }
    .hero-button{ margin-top: 20px; }

    /* Productos */
    .titulo-productos h2{
        margin: 60px 0 20px;
        padding: 0 20px;
    }
    .titulo-productos h4{
        margin: 20px 0;
        font-size: 18px;
        padding: 0 20px;
    }
    .productos-container{ margin-top: 40px; }

    /* Ofertas: en columna y centrado (el botón deja de ser absolute) */
    .Ofertas{
        height: auto;
        min-height: 25rem;
        margin-top: 40px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 20px;
        box-sizing: border-box;
    }
    .Ofertas h3{
        font-size: 28px;
        margin: 0 0 20px 0;
    }
    .button-ofertas{
        position: static;
        margin: 0;
        height: auto;
    }

    /* Opiniones: una debajo de otra */
    .opiniones h2,
    .opiniones h4{ padding-left: 20px; padding-right: 20px; }
    .opiniones-lista{
        flex-direction: column;
        align-items: center;
    }
    .opiniones p,
    .opiniones .opinion-2{
        width: 90%;
        font-size: 18px;
        box-sizing: border-box;
    }

    /* Email: todo apilado y centrado */
    .email{
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px 20px 40px;
    }
    .email h3{
        margin: 20px 0 10px;
        font-size: 26px;
    }
    .email h4{
        position: static;          /* estaba absolute y se pisaba con el resto */
        margin: 0 0 20px 0;
        font-size: 18px;
    }
    .form-correo{
        flex-direction: column;
        margin: 0;
        width: 100%;
    }
    .Correo,
    .boton-correo{
        width: 100%;
        max-width: 350px;
    }

    /* Footer: una sección debajo de la otra */
    footer{
        flex-direction: column;
        align-items: flex-start;
    }
    .contacto-footer,
    .Mi-cuenta{ margin: 2rem 1.5rem; }
}

/* ---------- Celulares (hasta 480px) ---------- */
@media (max-width: 480px){

    h1, h2{ font-size: 26px; }

    .hero{ height: 32rem; }
    .hero .hero-content{ margin-top: 60px; }
    .hero .hero-content h2{ font-size: 1.8rem; }
    .hero .hero-content h1{ font-size: 1.6rem; }

    /* Productos: 1 columna */
    .productos-container{
        grid-template-columns: 1fr;
        gap: 16px;
    }
    .productos-container .producto h5,
    .productos-container .producto h4{ font-size: 20px; }

    .Ofertas h3{ font-size: 24px; }

    .opiniones p,
    .opiniones .opinion-2{ width: 95%; }

    .email h3{ font-size: 22px; }
}
